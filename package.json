{
  "name": "macos-ui-mcp",
  "version": "0.1.0",
  "description": "Playwright-style MCP server for inspecting and driving a native macOS app's UI without Screen Recording permission.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "macos-ui-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:showcase && E2E=1 vitest run test/e2e.test.ts",
    "build:harness": "swift build --package-path swift-harness",
    "build:showcase": "swift build --package-path showcase",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
